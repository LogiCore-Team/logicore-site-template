# ==============================================================================
#                      متجر ياقوت - نموذج متغيرات البيئة (.env.example)
#                      YAGOT Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. إعدادات خادم السيرفر وبيئة التشغيل (Runtime & Server Configuration)
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
PORT=10000


# ------------------------------------------------------------------------------
# 2. رابط المتجر العام المعتمد (Live Storefront URL)
# ------------------------------------------------------------------------------
PublicUrl__BaseUrl=https://your-storefront-name.onrender.com/


# ------------------------------------------------------------------------------
# 3. قواعد بيانات Neon PostgreSQL (Database Connection Strings)
# ------------------------------------------------------------------------------
ConnectionStrings__MYDB=Host=ep-xxxx-pooler.c-5.eu-central-1.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=your_password;SSL Mode=Require;Trust Server Certificate=true;KeepAlive=30;TcpKeepAlive=true;Timeout=30;CommandTimeout=60
ConnectionStrings__User=Host=ep-xxxx-pooler.c-2.us-west-2.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=your_password;SSL Mode=Require;Trust Server Certificate=true;KeepAlive=30;TcpKeepAlive=true;Timeout=30;CommandTimeout=60
ConnectionStrings__UsersConnection=Host=ep-xxxx-pooler.c-2.us-west-2.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=your_password;SSL Mode=Require;Trust Server Certificate=true;KeepAlive=30;TcpKeepAlive=true;Timeout=30;CommandTimeout=60


# ------------------------------------------------------------------------------
# 4. الربط مع لوحة التحكم المركزية (Control Panel Integration - Site #1)
# ------------------------------------------------------------------------------
YagotIntegration__SiteId=1
YagotIntegration__ControlPanelBaseUrl=https://controlpanelsite-d7ta.onrender.com/
YagotIntegration__SnapshotApiKey=yagot-prod-snapshot-key-safe-val-12345
YagotIntegration__WebhookKeyId=wh-key-prod-1
YagotIntegration__WebhookSecret=prod-webhook-secret-must-be-32-chars-long!
YagotIntegration__TimestampToleranceSeconds=300
YagotIntegration__ReconciliationIntervalMinutes=30
YagotIntegration__SnapshotHttpTimeoutSeconds=10


# ------------------------------------------------------------------------------
# 5. ربط منظومة الموديولات والخصائص (Capability Integration - Site #1)
# ------------------------------------------------------------------------------
CapabilityIntegration__SiteId=1


# ------------------------------------------------------------------------------
# 6. خدمة رفع الصور الخارجية (Uploadcare)
# ------------------------------------------------------------------------------
Uploadcare__PublicKey=
Uploadcare__Store=1
Uploadcare__UseLocalFallback=false


# ------------------------------------------------------------------------------
# 7. تسجيل الدخول عبر Google (Google Authentication OAuth)
# ------------------------------------------------------------------------------
Authentication__Google__ClientId=your-google-client-id.apps.googleusercontent.com
Authentication__Google__ClientSecret=your-google-client-secret


# ------------------------------------------------------------------------------
# 8. إعدادات البريد الإلكتروني (Email & SMTP Settings)
# ------------------------------------------------------------------------------
Email__FromAddress=your-email@gmail.com
Email__FromName=YAGOT
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__EnableSsl=true
Email__Smtp__UserName=your-email@gmail.com
Email__Smtp__Password=your-app-password
Email__Smtp__TimeoutMilliseconds=30000


# ------------------------------------------------------------------------------
# 9. مفاتيح التشفير والحماية (Security & Encryption Keys)
# ------------------------------------------------------------------------------
Encryption__Key=7ab2C3d4E5f6G7h8I9j0Khs2M3n4Oiod
Encryption__IV=Xrj123lz6789Aa7D
